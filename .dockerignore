# Keep both production build contexts small and exclude local/generated data.
.git
.claude
bin
/agent
/server
/rmm-remote
/rmm-sign
*.exe
docs
deploy
# …except the published artifacts, which the `artifacts` image serves at /dl/.
# The negation is deliberately narrow: deploy/ is excluded precisely because it
# also holds deploy/secrets/, and that must never reach a build context.
!deploy/public
deploy/public/*.env
*.md
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
**/secrets
**/secrets/**
**/backups
**/backups/**
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.age
**/*.dump
**/*.backup
**/*.bak
**/id_rsa*
**/id_ed25519*
**/*state*.json
**/*.sqlite
**/*.sqlite3
**/*.db
.gitignore
Makefile
docker-compose.yml
Dockerfile
openrmm/node_modules
openrmm/dist
openrmm/tests
openrmm/uploads
openrmm/.thumbnail
# The docs site (docs.openrmm.io) is built and published on its own.
website
**/*.log
**/.DS_Store
