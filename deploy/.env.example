# Public HTTPS origins. TLS must terminate at the trusted edge.
RMM_PUBLIC_URL=https://agents.rmm.example.com
RMM_MCP_PUBLIC_URL=https://mcp.rmm.example.com
# The update signing PUBLIC key (bin/rmm-sign -print-public-key). The console
# puts it in the install commands; the server refuses to start on a malformed one.
RMM_UPDATE_PUBLIC_KEY=REPLACE_WITH_BASE64_ED25519_PUBLIC_KEY
RMM_MCP_OAUTH_ENABLED=false
# Canonical path with both leading and trailing slash, e.g. /console/.
OPENRMM_BASE_PATH=/

# Provision required placeholders with deploy/ops/provision-secrets.sh. It
# creates deploy/secrets mode 0700 and random files mode 0444 without replacing
# existing values. Local Compose preserves file modes; the protected parent
# directory prevents other host users from traversing to these non-root-readable
# mounts. Never commit deploy/secrets. The settings key must remain stable.
POSTGRES_PASSWORD_FILE=./secrets/postgres_password
RMM_ADMIN_TOKEN_FILE=./secrets/admin_token
RMM_SETTINGS_ENCRYPTION_KEY_FILE=./secrets/settings_encryption_key
# Optional. Leave empty to mount /dev/null; no placeholder file is required.
RMM_AI_API_KEY_FILE=

# SQL identifiers only: letters, digits and underscore. Operational scripts use
# the same values, so these are not silently fixed to rmm.
POSTGRES_USER=rmm
POSTGRES_DB=rmm

# Published listeners bind to loopback by default. Source ACLs then belong to
# the upstream TLS edge; these binds do not create or imply an internal UFW ACL.
# Change an address only when the external edge requires it and applies the ACL.
AGENTS_BIND_ADDRESS=127.0.0.1
AGENTS_PORT=8443
CONSOLE_BIND_ADDRESS=127.0.0.1
CONSOLE_PORT=9443
MCP_BIND_ADDRESS=127.0.0.1
MCP_PORT=7443

# The Docker network the published ports arrive from. nginx trusts
# X-Forwarded-For only from it, plus OPENRMM_TRUSTED_PROXY — set that to the
# address of a TLS edge on another machine when a bind address is not loopback.
EDGE_SUBNET=172.30.240.0/24
OPENRMM_TRUSTED_PROXY=127.0.0.1

RMM_MCP_ALLOWED_IPS=
RMM_TRUST_PROXY_HEADERS=true
RMM_ENFORCE_CONSOLE_RELAY_INGRESS=true
RMM_ALLOW_LEGACY_AGENT_RELAY=false
RMM_ALLOW_UNAPPROVED_JOBS=false
RMM_API_RATE_LIMIT=600
RMM_ALERT_RETENTION_DAYS=90
RMM_CHECK_RESULT_RETENTION_DAYS=90
RMM_NOTIFICATION_RETENTION_DAYS=90
RMM_AI_PROVIDER=openai-compatible
RMM_AI_BASE_URL=https://api.openai.com/v1
RMM_AI_MODEL=gpt-4o-mini
RMM_REMOTE_PROVIDER=native

# Runtime limits; tune after measuring the installation workload.
POSTGRES_MEMORY_LIMIT=2g
POSTGRES_CPU_LIMIT=2.0
POSTGRES_PIDS_LIMIT=256
SERVER_MEMORY_LIMIT=1g
SERVER_CPU_LIMIT=2.0
SERVER_PIDS_LIMIT=256
FRONTEND_MEMORY_LIMIT=256m
FRONTEND_CPU_LIMIT=0.50
FRONTEND_PIDS_LIMIT=128

# Operational scripts. These values are parsed safely from this file.
BACKUP_DIR=/var/backups/openrmm
BACKUP_REQUIRE_ENCRYPTION=true
BACKUP_AGE_RECIPIENT=
BACKUP_AGE_IDENTITY_FILE=
BACKUP_RCLONE_DEST=
BACKUP_OFFSITE_REQUIRED=false
VERIFY_FULL_RESTORE=true
RESTORE_WAIT_TIMEOUT=180
RESTORE_WRITER_SERVICES="frontend server"
# Defaults to BACKUP_DIR/restore.log when empty.
RESTORE_LOG_FILE=

# Controlled image update mechanism. Defaults are exact patch versions pinned
# to verified multi-architecture registry digests in the Compose/Dockerfile.
# POSTGRES_IMAGE=postgres:16.10-alpine@sha256:029660641a0cfc575b14f336ba448fb8a75fd595d42e1fa316b9fb4378742297
# GO_IMAGE=golang:1.26.10-alpine@sha256:5cb67f19c5e7994dcb80c074f7cfca8aeeada45bbdca035f73df269cefdcce61
# NODE_IMAGE=node:24.4.1-alpine@sha256:820e86612c21d0636580206d802a726f2595366e1b867e564cbc652024151e8a
# ALPINE_IMAGE=alpine:3.24.1@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b
# NGINX_IMAGE=nginx:1.27.5-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10

# Published images and the Caddy TLS edge (deploy/QUICKSTART.md). COMPOSE_FILE
# lets a plain `docker compose` use the layered files.
# COMPOSE_FILE=docker-compose.prod.yml:docker-compose.images.yml:docker-compose.caddy.yml
# AGENTS_HOST=agents.rmm.example.com
# CONSOLE_HOST=console.rmm.example.com
# MCP_HOST=mcp.rmm.example.com
# ACME_EMAIL=ops@example.com
# CONSOLE_ALLOWED_RANGES=0.0.0.0/0 ::/0
# MCP_ALLOWED_RANGES=0.0.0.0/0 ::/0
# Another release than the pinned one; keep deploy/ at that same release.
# OPENRMM_SERVER_IMAGE=ghcr.io/openrmm-project/openrmm-server:X.Y.Z
# OPENRMM_FRONTEND_IMAGE=ghcr.io/openrmm-project/openrmm-frontend:X.Y.Z
# OPENRMM_ARTIFACTS_IMAGE=ghcr.io/openrmm-project/openrmm-artifacts:X.Y.Z
