<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Embedded into the macOS sidecar's Mach-O as __TEXT,__info_plist.

  A command-line tool is not a bundle, so macOS has no identity to attribute a
  privacy request to and no purpose string to put in the dialog: it neither
  prompts nor lists the tool, and the operator has nothing to allow. On macOS 15
  the first thing that costs is local networking — the relay dial fails with
  "no route to host", which reads like a routing fault and is not one.
-->
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key><string>com.openrmm.remote</string>
  <key>CFBundleName</key><string>OpenRMM Remote</string>
  <key>CFBundleExecutable</key><string>rmm-remote</string>
  <key>LSUIElement</key><true/>
  <key>NSLocalNetworkUsageDescription</key>
  <string>OpenRMM connects to your organisation's RMM server to stream this Mac's screen to an authorised technician.</string>
</dict>
</plist>
