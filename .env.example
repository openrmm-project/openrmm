# --- Server ---
RMM_HTTP_ADDR=:8080
# Bundled Docker Compose publishes the proxy at :3005. Override for a direct
# server or public agents ingress.
RMM_PUBLIC_URL=http://localhost:3005
# Public HTTPS origin of the MCP door. Required when RMM_MCP_OAUTH_ENABLED=true;
# separate this from RMM_PUBLIC_URL in a split-ingress deployment.
RMM_MCP_PUBLIC_URL=
RMM_DATABASE_URL=postgres://rmm:rmm@localhost:5432/rmm?sslmode=disable

# Bootstrap admin API token. REQUIRED, minimum 32 characters (server refuses to
# start otherwise). Generate with `openssl rand -hex 32`.
# Accepted as a valid bearer token so you can enroll agents / create tokens.
RMM_ADMIN_TOKEN=change-me-to-a-long-random-string
# Optional dedicated key for encrypting editable secrets stored in app_settings.
# If unset, the server derives the encryption key from RMM_ADMIN_TOKEN.
RMM_SETTINGS_ENCRYPTION_KEY=

# --- AI / LLM (OpenAI-compatible) ---
# Works with OpenAI, or any OpenAI-compatible endpoint including local models
# served by Ollama (http://localhost:11434/v1) or vLLM. BYO-model, privacy-first.
RMM_AI_BASE_URL=https://api.openai.com/v1
RMM_AI_API_KEY=
RMM_AI_MODEL=gpt-4o-mini

# --- Remote access ---
# Default provider when none is specified: native | meshcentral
RMM_REMOTE_PROVIDER=native
# Toggle the MeshCentral provider on/off (also editable in Settings). On by
# default; set to false to hide MeshCentral from the device Remote menu.
RMM_MESHCENTRAL_ENABLED=true
# Base URL of your MeshCentral server (required for the meshcentral provider).
RMM_MESHCENTRAL_URL=
# MeshCentral loginTokenKey (hex) for seamless iframe embedding (no 2nd login).
# Requires "AllowLoginToken": true and "AllowFraming": true in MeshCentral.
# Leave empty to use deep-link mode (works after logging into MeshCentral once).
RMM_MESHCENTRAL_TOKEN_KEY=
RMM_MESHCENTRAL_USER=admin
# Optional RustDesk provider. The RustDesk client is installed out-of-band; when
# enabled, the device Remote menu shows "RustDesk" and the agent reads the
# device's id on demand so the console opens rustdesk://<id>. Toggle here or in
# the Settings screen. Off by default.
RMM_RUSTDESK_ENABLED=false

# --- Security ---
# Optional app-level IP allowlist for the /mcp endpoint (comma-separated IPs/CIDRs).
# Empty = no app-level restriction (rely on a private network / proxy instead).
RMM_MCP_ALLOWED_IPS=
# Enable only when RMM_MCP_PUBLIC_URL is an HTTPS MCP ingress that proxies
# /.well-known/* plus /oauth/* to the server.
RMM_MCP_OAUTH_ENABLED=false
# Set true ONLY when behind a trusted reverse proxy, so X-Forwarded-For is honored
# for the IP allowlist. Never enable if the server is directly internet-facing.
RMM_TRUST_PROXY_HEADERS=false
# Temporary rollout bridge for pre-ticket remote sidecars. Keep false in normal
# operation; viewer tickets are never accepted in URLs.
RMM_ALLOW_LEGACY_AGENT_RELAY=false
# Require browser relay peers to arrive through a proxy-marked console ingress.
# Set true with RMM_TRUST_PROXY_HEADERS=true for deploy/nginx.prod.conf's
# split-ingress topology.
RMM_ENFORCE_CONSOLE_RELAY_INGRESS=false
# Approval is mandatory for every ad-hoc/AI script run by default. Set true to
# allow callers to create pre-approved jobs (NOT recommended).
RMM_ALLOW_UNAPPROVED_JOBS=false
# Per-IP request budget per minute for the general authenticated API. It's a
# safety net against token-guessing, not a per-user quota; the single-page UI is
# chatty (polling + parallel queries on navigation), so keep generous headroom.
RMM_API_RATE_LIMIT=600

# --- Agent (for cmd/agent) ---
# RMM_SERVER_WS=ws://localhost:8080/ws/agent
# RMM_ENROLL_TOKEN=
# RMM_AGENT_STATE=agent-state.json
# Require WSS for the agent control channel. Leave false for local labs.
# RMM_REQUIRE_TLS=false
# Artifact verification for agent/sidecar downloads from /dl: warn | strict | off.
# Production target: strict, with RMM_UPDATE_PUBLIC_KEY configured or baked in.
# RMM_UPDATE_VERIFY=warn
# Base64 Ed25519 public key generated by `bin/rmm-sign -gen-key`.
# RMM_UPDATE_PUBLIC_KEY=
